{
  "bundle": {
    "icon": [
      "png/weekly_256.ico",
      "png/weekly_32.ico"
    ],
    "active": true,
    "resources": [
      "png/weekly_32.ico",
      "tools/yt-dlp.exe",
      "tools/ffmpeg.exe",
      "tools/deno.exe",
      "extensions/**/*"
    ],
    "targets": [
      "msi"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "wix": {
        "language": [
          "en-US"
        ],
        "template": "assets/main.wxs"
      }
    },
    "createUpdaterArtifacts": true
  }
}