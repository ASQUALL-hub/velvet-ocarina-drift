{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pake-capability",
  "description": "Capability for the pake app.",
  "webviews": [
    "pake",
    "pake-*"
  ],
  "permissions": [
    "allow-download-file",
    "allow-send-notification",
    "allow-close-notification",
    "allow-increment-dock-badge",
    "allow-set-dock-badge",
    "allow-set-dock-badge-label",
    "allow-clear-dock-badge",
    "allow-update-theme-mode",
    "allow-set-zoom",
    "allow-webview-navigate",
    "allow-set-title-bar-color",
    "shell:allow-open",
    "core:window:allow-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-resizable",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:webview:allow-internal-toggle-devtools",
    "core:webview:allow-print",
    "notification:allow-is-permission-granted",
    "notification:allow-notify",
    "notification:allow-get-active",
    "notification:allow-register-listener",
    "notification:allow-register-action-types",
    "notification:default",
    "core:path:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-inner-size",
    "core:window:allow-outer-size",
    "core:window:allow-set-decorations",
    "core:window:allow-set-min-size",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-current-monitor",
    "core:window:allow-scale-factor",
    "core:window:allow-set-focus",
    "core:window:allow-set-shadow",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-cursor-position",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "pake-ytdlp",
          "cmd": "$RESOURCE/tools/yt-dlp.exe",
          "args": [
            "--ignore-config",
            "--no-playlist",
            "--newline",
            "--encoding",
            "utf-8",
            "-f",
            "bv*+ba/b",
            "--merge-output-format",
            "mp4",
            "-P",
            "~\\Downloads",
            "-o",
            "%(title)s [%(id)s].%(ext)s",
            {
              "validator": "https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}"
            }
          ],
          "sidecar": false
        },
        {
          "name": "pake-ytdlp-stop",
          "cmd": "C:\\Windows\\System32\\taskkill.exe",
          "args": [
            "/F",
            "/T",
            "/FI",
            "IMAGENAME eq yt-dlp.exe",
            "/FI",
            {
              "validator": "PID eq \\d{1,7}"
            }
          ],
          "sidecar": false
        },
        {
          "name": "pake-show-download",
          "cmd": "C:\\Windows\\explorer.exe",
          "args": [
            "/select,",
            {
              "validator": "[A-Za-z]:\\\\Users\\\\[^\\\\/:*?\"<>|]+\\\\Downloads\\\\[^\\\\/:*?\"<>|]+"
            }
          ],
          "sidecar": false
        },
        {
          "name": "pake-open-downloads",
          "cmd": "C:\\Windows\\explorer.exe",
          "args": [
            {
              "validator": "[A-Za-z]:\\\\Users\\\\[^\\\\/:*?\"<>|]+\\\\Downloads"
            }
          ],
          "sidecar": false
        }
      ]
    },
    "updater:default"
  ]
}